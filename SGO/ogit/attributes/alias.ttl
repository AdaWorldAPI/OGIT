@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix owl:                    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit:alias
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "alias";
	dcterms:description """A comma-separated list of alternative names associated with the entity.
Aliases include nicknames, abbreviations, acronyms, short names, or other names by which the entity is known.""";
	# For ranges, see https://www.dublincore.org/specifications/dublin-core/dcmi-period/
	dcterms:valid "start=2025-07-04;";
	dcterms:creator "Calvin Spolwind";
.
