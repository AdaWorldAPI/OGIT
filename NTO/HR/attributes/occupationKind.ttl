@prefix ogit:                 <http://www.purl.org/ogit/> .
@prefix ogit.HR:              <http://www.purl.org/ogit/HR/> .
@prefix owl:                  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                 <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:              <http://purl.org/dc/terms/> .

ogit.HR:occupationKind
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "occupationKind";
	dcterms:description "Which kind of register entry an occupation is: one of three kinds of education, or the occupation as it is practised.";
	ogit:validation-type "fixed";
	ogit:validation-parameter "vocationalTraining,furtherTraining,courseOfStudy,practisedOccupation";
	dcterms:valid "start=2026-08-17;";
	dcterms:creator "Almato AG";
.
