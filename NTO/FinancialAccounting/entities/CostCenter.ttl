@prefix ogit.FinancialAccounting:     <http://www.purl.org/ogit/FinancialAccounting/> .
@prefix ogit.CustomerSupport: <http://www.purl.org/ogit/CustomerSupport/> .
@prefix ogit:                   <http://www.purl.org/ogit/> .
@prefix rdfs:                   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:                <http://purl.org/dc/terms/> .

ogit.FinancialAccounting:CostCenter
  a rdfs:Class;
  rdfs:subClassOf ogit:Entity;
  rdfs:label "CostCenter";
  dcterms:description """An organizational unit to which costs are assigned for accounting and controlling purposes.""";
  dcterms:valid "start=2026-08-07;";
  dcterms:creator "Daniel Brommer";
  ogit:scope "NTO";
  ogit:parent "http://www.purl.org/ogit/Node";
  ogit:mandatory-attributes (
  );
  ogit:optional-attributes (
    ogit:name
    ogit:id
    ogit:description
    ogit:isValid
    ogit:validTo
    ogit:validFrom
    ogit:createdAt
    ogit:createdBy
    ogit:lastUpdatedAt
    ogit:lastUpdatedBy
    ogit:country
  );
  ogit:indexed-attributes (
  );
  ogit:allowed (
	[ ogit:belongs  ogit:Organization ]
  [ ogit:belongs  ogit.CustomerSupport:Group ]
  [ ogit:isPartOf ogit.FinancialAccounting:CostCenter]
  );
.
