@prefix ogit.WorkOrder:       <http://www.purl.org/ogit/WorkOrder/> .
@prefix ogit:                <http://www.purl.org/ogit/> .
@prefix owl:                 <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:             <http://purl.org/dc/terms/> .

ogit.WorkOrder:aktiv
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "aktiv";
	dcterms:description "Active flag (aktiv). Boolean; false archives or soft-disables the record instead of deleting it. Used by Article, Customer and Tenant.";
	dcterms:source "AdaWorldAPI/WoA/models.py:Article.aktiv", "AdaWorldAPI/WoA/models.py:Customer.aktiv", "AdaWorldAPI/WoA/models.py:Tenant.aktiv";
	dcterms:valid "start=2026-10-10;";
	dcterms:creator "claude-ogit-bootstrap";
.
