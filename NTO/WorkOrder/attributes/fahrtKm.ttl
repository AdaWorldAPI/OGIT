ogit.WorkOrder:fahrtKm
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "fahrtKm";
	dcterms:description "One-way travel distance in kilometres (Fahrt km). Multiplied by Order.anfahrten and fahrtKosten to compute the trip-cost line item.";
	dcterms:source "AdaWorldAPI/WoA/models.py:Customer.fahrt_km";
	dcterms:valid "start=2026-10-10;";
	dcterms:creator "claude-ogit-bootstrap";
.
