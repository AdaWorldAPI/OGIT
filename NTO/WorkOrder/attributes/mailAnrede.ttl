@prefix ogit.WorkOrder:       <http://www.purl.org/ogit/WorkOrder/> .
@prefix ogit:                <http://www.purl.org/ogit/> .
@prefix owl:                 <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:             <http://purl.org/dc/terms/> .

ogit.WorkOrder:mailAnrede
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "mailAnrede";
	dcterms:description "Email salutation override (mail_anrede). Free-text override for the opening line of automated mails (e.g. 'Sehr geehrte Frau Mueller'). When empty, derived from anrede + nachname.";
	dcterms:source "AdaWorldAPI/WoA/models.py:Customer.mail_anrede";
	dcterms:valid "start=2026-10-10;";
	dcterms:creator "claude-ogit-bootstrap";
.
