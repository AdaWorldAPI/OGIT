@prefix ogit.WorkOrder:       <http://www.purl.org/ogit/WorkOrder/> .
@prefix ogit:                <http://www.purl.org/ogit/> .
@prefix owl:                 <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:             <http://purl.org/dc/terms/> .

ogit.WorkOrder:beschreibung
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "beschreibung";
	dcterms:description "Free-text description (Beschreibung): the article text printed on order positions, or the work performed in a time entry.";
	dcterms:source "AdaWorldAPI/WoA/models.py:Article.beschreibung", "AdaWorldAPI/WoA/models.py:TimeSheet.beschreibung";
	dcterms:valid "start=2026-10-10;";
	dcterms:creator "claude-ogit-bootstrap";
.
