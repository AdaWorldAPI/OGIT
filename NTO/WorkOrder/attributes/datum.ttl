@prefix ogit.WorkOrder:       <http://www.purl.org/ogit/WorkOrder/> .
@prefix ogit:                <http://www.purl.org/ogit/> .
@prefix owl:                 <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:             <http://purl.org/dc/terms/> .

ogit.WorkOrder:datum
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "datum";
	dcterms:description "ISO-8601 calendar date of the record (Datum): the document date of an order, or the date of a logbook trip.";
	dcterms:source "AdaWorldAPI/WoA/models.py:LogbookEntry.datum", "AdaWorldAPI/WoA/models.py:WorkOrder.datum";
	dcterms:valid "start=2026-10-10;";
	dcterms:creator "claude-ogit-bootstrap";
.
