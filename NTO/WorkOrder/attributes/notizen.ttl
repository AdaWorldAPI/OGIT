@prefix ogit.WorkOrder:       <http://www.purl.org/ogit/WorkOrder/> .
@prefix ogit:                <http://www.purl.org/ogit/> .
@prefix owl:                 <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:                <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:             <http://purl.org/dc/terms/> .

ogit.WorkOrder:notizen
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "notizen";
	dcterms:description "Free-text notes (Notizen). Internal on a customer; printed below the position list on an order.";
	dcterms:source "AdaWorldAPI/WoA/models.py:Customer.notizen", "AdaWorldAPI/WoA/models.py:WorkOrder.notizen";
	dcterms:valid "start=2026-10-10;";
	dcterms:creator "claude-ogit-bootstrap";
.
