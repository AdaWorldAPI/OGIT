ogit.WorkOrder:lieferantAnr
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "lieferantAnr";
	dcterms:description "Supplier-side article number (Lieferanten-Artikelnummer). Used when reordering: the artikelnr is the tenant-local code, lieferantAnr is the SKU at the supplier.";
	dcterms:source "AdaWorldAPI/WoA/models.py:Article.lieferant_anr";
	dcterms:valid "start=2026-10-10;";
	dcterms:creator "claude-ogit-bootstrap";
.
