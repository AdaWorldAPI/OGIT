ogit.WorkOrder:anKunde
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "anKunde";
	dcterms:description "Customer flag (an_kunde). Boolean; true makes the attachment visible to, or sends it to, the customer.";
