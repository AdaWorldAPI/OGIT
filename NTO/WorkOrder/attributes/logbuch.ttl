@prefix dcterms:             <http://purl.org/dc/terms/> .

ogit.WorkOrder:logbuch
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "logbuch";
	dcterms:description "Logbook flag (Logbuch). Boolean; true includes the record in the driver/work logbook export.";
