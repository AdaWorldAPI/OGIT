@prefix ogit.Accounting:  <http://www.purl.org/ogit/Accounting/> .
@prefix ogit:             <http://www.purl.org/ogit/> .
@prefix owl:              <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:          <http://purl.org/dc/terms/> .

ogit.Accounting:isEuMember
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "isEuMember";
	dcterms:description "True if this fiscal jurisdiction is a current EU member state. Used to decide intra-EU reverse charge, Peppol/UBL routing and OSS classification.";
	dcterms:valid "start=2026-05-28;";
	dcterms:creator "Claude (AdaWorldAPI)";
.
