@prefix ogit.Accounting:  <http://www.purl.org/ogit/Accounting/> .
@prefix ogit:             <http://www.purl.org/ogit/> .
@prefix owl:              <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:          <http://purl.org/dc/terms/> .

ogit.Accounting:iso3166Alpha2
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "iso3166Alpha2";
	dcterms:description "Two-letter ISO 3166-1 alpha-2 country code (for example `DE`, `AT`, `CH`, `US`). The indexed key of FiscalJurisdiction: one jurisdiction per code. The same two-letter code is used by Peppol/UBL, by the country segment of a SWIFT BIC and by sanctions-list jurisdiction filters.";
	dcterms:valid "start=2026-05-28;";
	dcterms:creator "Claude (AdaWorldAPI)";
.
