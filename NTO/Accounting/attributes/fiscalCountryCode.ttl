@prefix ogit.Accounting:  <http://www.purl.org/ogit/Accounting/> .
@prefix ogit:             <http://www.purl.org/ogit/> .
@prefix owl:              <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:          <http://purl.org/dc/terms/> .

ogit.Accounting:fiscalCountryCode
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "fiscalCountryCode";
	dcterms:description "ISO 3166-1 alpha-2 code of the fiscal country of the company that owns this entity. Used for VAT calculation, sanctions checks and jurisdiction routing. Kept on the entity so these checks do not have to follow the company relation; the hasFiscalCountry edge gives the same jurisdiction as a FiscalJurisdiction node.";
	dcterms:valid "start=2026-05-28;";
	dcterms:creator "Claude (AdaWorldAPI)";
.
