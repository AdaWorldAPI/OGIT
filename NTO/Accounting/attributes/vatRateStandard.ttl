@prefix ogit.Accounting:  <http://www.purl.org/ogit/Accounting/> .
@prefix ogit:             <http://www.purl.org/ogit/> .
@prefix owl:              <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:          <http://purl.org/dc/terms/> .

ogit.Accounting:vatRateStandard
	a owl:DatatypeProperty;
	rdfs:subPropertyOf ogit:Attribute;
	rdfs:label "vatRateStandard";
	dcterms:description "Standard VAT rate of this fiscal jurisdiction as a decimal fraction (for example `0.19` for 19%). Reduced rates and exemptions are not modelled here; use the jurisdiction's Tax entity for those.";
	dcterms:valid "start=2026-05-28;";
	dcterms:creator "Claude (AdaWorldAPI)";
.
