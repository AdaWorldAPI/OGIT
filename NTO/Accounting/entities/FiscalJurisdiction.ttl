@prefix ogit.Accounting:  <http://www.purl.org/ogit/Accounting/> .
@prefix ogit:             <http://www.purl.org/ogit/> .
@prefix ogit.Compliance:  <http://www.purl.org/ogit/Compliance/> .
@prefix ogit.FinancialMarket: <http://www.purl.org/ogit/FinancialMarket/> .
@prefix rdfs:             <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms:          <http://purl.org/dc/terms/> .

ogit.Accounting:FiscalJurisdiction
	a rdfs:Class;
	rdfs:subClassOf ogit:Entity;
	rdfs:label "FiscalJurisdiction";
	dcterms:description "A fiscal jurisdiction, identified by its ISO 3166-1 alpha-2 code: one entry per code. The target of hasFiscalCountry edges. Carries the standard VAT rate and EU membership, so jurisdiction-dependent rules (reverse charge, OSS, record-keeping obligations) read an attribute instead of following further edges. Links to a sanctions entry when the jurisdiction runs a sanctions programme.";
	dcterms:valid "start=2026-05-28;";
	dcterms:creator "Claude (AdaWorldAPI)";
	ogit:scope "NTO";
	ogit:parent ogit:Node;
	ogit:mandatory-attributes (
		ogit.Accounting:iso3166Alpha2
	);
	ogit:optional-attributes (
		ogit:name
		ogit.Accounting:vatRateStandard
		ogit.Accounting:isEuMember
	);
	ogit:indexed-attributes (
		ogit.Accounting:iso3166Alpha2
		ogit.Accounting:isEuMember
	);
	ogit:allowed (
		[ ogit:references ogit.Compliance:SanctionsEntry ]
		[ ogit:references ogit.FinancialMarket:Country ]
	);
.
